# =====================================================================
# SCM 4K Command Center - Environment Variables Template
# Copy this file to .env and configure for local or cloud environments
# =====================================================================

# 1. MySQL 8.x Database Configuration (Local or Cloud e.g. Railway / Aiven)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scm_db
DB_USER=root
DB_PASS=your_secure_password

# Optional: Cloud Connection URL (If using Railway MYSQL_URL or Render DATABASE_URL)
# MYSQL_URL=mysql://user:password@containers-us-west-xx.railway.app:port/railway

# Optional SSL CA certificate file path (required for Aiven)
# MYSQL_SSL_CA=/path/to/ca.pem

# 2. Node.js Real-Time Telemetry & Socket.io Service Configuration
PORT=3000
CORS_ORIGIN=*

# URL to which PHP APIs send internal webhooks
NODE_SERVICE_URL=http://localhost:3000

# 3. Security & JWT Secrets
JWT_SECRET=scm_super_secret_4k_radar_key_2026
